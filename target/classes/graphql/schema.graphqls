type Category {
    id: ID!
    name: String!
    description: String
    products: [Product!]!
}

type Product {
    id: ID!
    title: String!
    description: String
    images: String
    price: Float!
    amount: Int
    category: Category
}

type PageInfo {
    totalElements: Int!
    totalPages: Int!
    number: Int!
    size: Int!
}

type ProductPage {
    content: [Product!]!
    pageInfo: PageInfo!
}

type CategoryPage {
    content: [Category!]!
    pageInfo: PageInfo!
}

input ProductInput {
    title: String!
    description: String
    images: String
    price: Float!
    amount: Int
    categoryId: ID!
}

input CategoryInput {
    name: String!
    description: String
}

type Query {
    # Yêu cầu 1
    productsByPriceAsc: [Product!]!

    # Yêu cầu 2
    productsByCategory(categoryId: ID!): [Product!]!
    categories: [Category!]!

    # Yêu cầu 3 - Product
    products(page: Int = 0, size: Int = 10, keyword: String): ProductPage!
    productById(id: ID!): Product

    # Yêu cầu 3 - Category
    categoriesPage(page: Int = 0, size: Int = 10, keyword: String): CategoryPage!
    categoryById(id: ID!): Category
}

type Mutation {
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!

    createCategory(input: CategoryInput!): Category!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!
}
