type Category {
    id: ID!
    name: String!
    description: String
    products: [Product!]!
}

type Product {
    id: ID!
    title: String!
    description: String
    images: String
    price: Float!
    amount: Int
    category: Category
}

type Query {
    # Yêu cầu 1: tất cả product sắp xếp theo price tăng dần
    productsByPriceAsc: [Product!]!
}
